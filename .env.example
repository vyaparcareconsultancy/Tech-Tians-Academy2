# =============================================================================
# Tech Tians Academy — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. The values below are placeholders.
# =============================================================================

# --- Supabase (leave EMPTY to run in DEMO MODE with mock data) ---------------
# Project URL:  Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=
# Public anon key (safe for browser). NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# App branding (optional)
VITE_APP_NAME=Tech Tians Academy

# When Supabase credentials are absent, the app runs in clearly-labelled
# DEMO MODE: login uses the demo accounts listed in README.md and all data
# is generated mock data held in memory (nothing is persisted or sent anywhere).
